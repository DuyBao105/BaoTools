<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\BaoToolsGui\icon.ico</ApplicationIcon>
    <AssemblyName>BaoTools_v10.5_Setup</AssemblyName>
    <RootNamespace>BaoToolsInstaller</RootNamespace>
    <AssemblyTitle>BaoTools Setup</AssemblyTitle>
    <AssemblyDescription>BaoTools Installer</AssemblyDescription>
    <Version>10.5.0</Version>
    <FileVersion>10.5.0.0</FileVersion>
    <InformationalVersion>10.5.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\BaoToolsGui\icon.ico">
      <Link>icon.ico</Link>
    </Resource>
    <EmbeddedResource Include="..\..\release_v10.5\BaoTools_v10.5_Portable.zip">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
