<Window x:Class="BaoToolsInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaoTools Setup"
        Width="660"
        Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Title bar icon buttons -->
        <Style x:Key="TitleBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2333" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Solid Gaming Primary Button -->
        <Style x:Key="SolidPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#075985" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Browse) -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1E2D" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2A334A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#242B3D" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark Gaming CheckBox (Entire row clickable) -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" VerticalAlignment="Center" Cursor="Hand" Padding="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckBorder"
                                        Width="16" Height="16"
                                        Background="#0E111A"
                                        BorderBrush="#2E374E"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Width="9" Height="8"
                                          Stretch="Uniform"
                                          Fill="#FFFFFF"
                                          Data="M 1 4 L 3.5 6.5 L 8 1"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#0284C7" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#0284C7" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#11131C" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2436" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              ClickMode="Press"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="#141724"
                                    BorderBrush="#252B3E"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="6,2">
                                <Grid>
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Fill="#64748B"
                                          Data="M 0 0 L 3.5 3.5 L 7 0 Z" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                                    <Setter TargetName="Border" Property="Background" Value="#1B1F2E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="8,0,18,0" />
                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Grid x:Name="DropDown"
                          SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder"
                                Background="#11131C"
                                BorderBrush="#252B3E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,3,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.6" ShadowDepth="3" Color="#000000" />
                            </Border.Effect>
                            <ScrollViewer Margin="2" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MaxDropDownHeight" Value="220" />
        </Style>
    </Window.Resources>

    <!-- Outer Margins for DropShadow -->
    <Grid Margin="12">
        <!-- Main Window Container with 14px rounded corners -->
        <Border CornerRadius="14"
                Background="#0F1118"
                BorderBrush="#252B3E"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" Opacity="0.45" ShadowDepth="3" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" /> <!-- Title Bar -->
                    <RowDefinition Height="*" />  <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- Title Bar with matching rounded top corners -->
                <Border Grid.Row="0"
                        CornerRadius="13,13,0,0"
                        Background="#131622"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="BaoTools" FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" VerticalAlignment="Center" />
                            <TextBlock Text="10.5" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right Controls: Language Selector + Window Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                            <!-- Globe icon -->
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#64748B" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                            <ComboBox x:Name="CmbLanguage"
                                      Style="{StaticResource DarkComboBox}"
                                      Width="116"
                                      Height="24"
                                      Margin="0,0,8,0"
                                      SelectionChanged="CmbLanguage_SelectionChanged" />
                            <Button Content="—" Style="{StaticResource TitleBtnStyle}" Click="Minimize_Click" />
                            <Button Content="✕" Style="{StaticResource CloseBtnStyle}" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area with matching rounded bottom corners -->
                <Border Grid.Row="1" CornerRadius="0,0,13,13" Background="#0F1118">
                    <Grid>
                        <!-- VIEW 1: READY TO INSTALL -->
                        <Grid x:Name="ViewReady" Visibility="Visible" Margin="0,18,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header: Mascot & Title -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Image x:Name="HeroLogo" Width="68" Height="68" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="TxtHeroTitle"
                                           Text="Install BaoTools"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,2" />
                                <TextBlock x:Name="TxtHeroSubtitle"
                                           Text="Version 10.5.0 • All-in-one Game Manager"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Configuration Card with rounded 10px corners -->
                            <Border Grid.Row="1"
                                    Width="520"
                                    Background="#141723"
                                    BorderBrush="#23293C"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    HorizontalAlignment="Center">
                                <StackPanel>
                                    <TextBlock x:Name="LblInstallLocation"
                                               Text="INSTALL LOCATION"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtInstallPath"
                                                 Background="#0D0F17"
                                                 Foreground="#F1F5F9"
                                                 BorderBrush="#23293C"
                                                 BorderThickness="1"
                                                 Padding="8,5"
                                                 FontSize="11.5"
                                                 VerticalAlignment="Center"
                                                 TextChanged="TxtInstallPath_TextChanged" />
                                        <Button x:Name="BtnBrowse"
                                                Grid.Column="1"
                                                Content="Browse..."
                                                Style="{StaticResource SecondaryBtn}"
                                                Padding="14,5"
                                                Margin="8,0,0,0"
                                                Click="BtnBrowse_Click" />
                                    </Grid>

                                    <!-- Shortcut option + Disk space info -->
                                    <Grid Margin="0,10,0,0">
                                        <CheckBox x:Name="ChkDesktopIcon"
                                                  Content="Create desktop shortcut"
                                                  IsChecked="True"
                                                  Style="{StaticResource DarkCheckBox}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtDiskSpace"
                                                   Text="Required: ~20 MB  •  Available: --"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Action Button & Terms -->
                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,14,0,0">
                                <Button x:Name="BtnInstall"
                                        Content="Install"
                                        Style="{StaticResource SolidPrimaryBtn}"
                                        Width="180"
                                        Height="36"
                                        Click="BtnInstall_Click" />
                                <TextBlock x:Name="TxtTerms"
                                           Text="By clicking Install, you agree to the software terms."
                                           FontSize="10"
                                           Foreground="#475569"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- VIEW 2: INSTALLING PROGRESS -->
                        <Grid x:Name="ViewInstalling" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Width="480">
                                <Image Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12" Source="{Binding ElementName=HeroLogo, Path=Source}" />
                                <TextBlock x:Name="TxtInstallingTitle"
                                           Text="Installing BaoTools..."
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16" />

                                <!-- Sleek Minimal Progress Bar -->
                                <Border Height="6" Background="#161A26" CornerRadius="3" ClipToBounds="True">
                                    <ProgressBar x:Name="InstallProgressBar"
                                                 Height="6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="#0284C7" />
                                </Border>

                                <Grid Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtStatus"
                                               Text="Extracting files..."
                                               FontSize="11"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TxtPercent"
                                               Text="0%"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#38BDF8"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- VIEW 3: COMPLETED -->
                        <Grid x:Name="ViewComplete" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Clean minimal success mark -->
                                <Border Width="44" Height="44" Background="#163828" CornerRadius="22" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="22" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <TextBlock x:Name="TxtCompleteTitle"
                                           Text="Installation Complete"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />

                                <TextBlock x:Name="TxtCompleteSubtitle"
                                           Text="BaoTools has been installed and is ready to launch."
                                           FontSize="11.5"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,18" />

                                <!-- Launch Button -->
                                <Button x:Name="BtnLaunch"
                                        Content="Launch BaoTools"
                                        Style="{StaticResource SolidPrimaryBtn}"
                                        Width="180"
                                        Height="36"
                                        Click="BtnLaunch_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
