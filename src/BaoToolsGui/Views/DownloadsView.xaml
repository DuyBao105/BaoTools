<UserControl
    x:Class="BaoToolsGui.Views.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:downloads="clr-namespace:BaoToolsGui.Services.Downloads"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:BaoToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:BaoToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  One live queue row: cover, title/source, progress + metrics, action buttons.  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type downloads:DownloadItem}">
            <Border
                Margin="0,0,0,8"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">

                <Border.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </Border.Tag>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Common_CopyAppId}"
                            Icon="{ui:SymbolIcon Copy24}"
                            Visibility="{Binding CanCopyAppId, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.PlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_Play}"
                            Icon="{ui:SymbolIcon Play24}"
                            Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.UninstallCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_Uninstall}"
                            Icon="{ui:SymbolIcon Delete24}"
                            Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Common_ShowInFolder}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Visibility="{Binding CanShowInFolder, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Cover  -->
                    <Border
                        Width="96"
                        Height="44"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource RadiusSM}"
                        ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="Games24" FontSize="22" Foreground="#20FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image
                                Source="{Binding CoverPath, Converter={StaticResource ImagePathToSource}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SubTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="6,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="·" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding StatusLabel}" />
                        </StackPanel>

                        <!--  "Action required" chip: the download is done but waiting on a confirmation.  -->
                        <Border
                            Margin="0,6,0,0"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{Binding NeedsAction, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{x:Static res:Strings.Downloads_ActionRequired}" />
                        </Border>

                        <!--  Multi-step detail, e.g. a depot job's "Depots - 3 of 12".  -->
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding Detail}"
                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />

                        <ProgressBar
                            Height="4"
                            Margin="0,8,0,0"
                            IsIndeterminate="{Binding IsIndeterminate}"
                            Maximum="100"
                            Value="{Binding Percent, Mode=OneWay}"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />

                        <!--  Size · rate · ETA. Each hides itself when it has nothing to say.  -->
                        <StackPanel
                            Margin="0,5,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SizeLabel}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding RateLabel}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding EtaLabel}" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Message}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!--  Actions. Each button shows only in the states where it means something.  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Review}"
                            Visibility="{Binding NeedsAction, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Appearance="Primary"
                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Play}"
                            Icon="{ui:SymbolIcon Play24}"
                            Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Appearance="Secondary"
                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon Delete24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_Uninstall}"
                            Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon Pause24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_Pause}"
                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Appearance="Primary"
                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Resume}"
                            Icon="{ui:SymbolIcon Play24}"
                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon ChevronUp24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_MoveUp}"
                            Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon ChevronDown24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_MoveDown}"
                            Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Cancel}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Retry}"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_Remove}"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One history row: modern card, cover art, badges, and quick actions.  -->
        <DataTemplate x:Key="HistoryItemTemplate" DataType="{x:Type downloads:DownloadHistoryEntry}">
            <Border
                Margin="0,0,0,8"
                Padding="12,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMD}">
                <Border.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </Border.Tag>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_Play}"
                            Icon="{ui:SymbolIcon Play24}"
                            Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.UninstallHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Downloads_Action_Uninstall}"
                            Icon="{ui:SymbolIcon Delete24}"
                            Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.CopyHistoryAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Common_CopyAppId}"
                            Icon="{ui:SymbolIcon Copy24}"
                            Visibility="{Binding CanCopyAppId, Converter={StaticResource BoolToVis}}" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.ShowHistoryInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding}"
                            Header="{x:Static res:Strings.Common_ShowInFolder}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Visibility="{Binding CanShowInFolder, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Cover thumbnail with fallback  -->
                    <Border
                        Width="96"
                        Height="44"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource RadiusSM}"
                        ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="Games24" FontSize="22" Foreground="#20FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image
                                Source="{Binding CoverPath, Converter={StaticResource ImagePathToSource}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!--  Info Column  -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontWeight="SemiBold"
                                FontSize="13.5"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="480" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource RadiusXS}"
                                Visibility="{Binding CanCopyAppId, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontFamily="{StaticResource FontCode}"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding AppId, StringFormat='#{0}'}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Status Chip: Success or Error -->
                            <Border
                                Padding="6,1.5"
                                Background="{StaticResource StatusSuccessBackgroundBrush}"
                                CornerRadius="{StaticResource RadiusXS}"
                                Visibility="{Binding Failed, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource StatusSuccessBrush}"
                                    Text="{Binding StatusLabel}" />
                            </Border>
                            <Border
                                Padding="6,1.5"
                                Background="{StaticResource StatusErrorBackgroundBrush}"
                                CornerRadius="{StaticResource RadiusXS}"
                                Visibility="{Binding Failed, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource StatusErrorBrush}"
                                    Text="{Binding StatusLabel}" />
                            </Border>

                            <TextBlock
                                Margin="6,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="·" />

                            <TextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SubTitle}" />

                            <TextBlock
                                Margin="6,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="·" />

                            <TextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SizeLabel}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Timestamp  -->
                    <TextBlock
                        Grid.Column="2"
                        Margin="14,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding WhenLabel}" />

                    <!--  Action Buttons  -->
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="4,0,0,0"
                            Padding="10,4"
                            Appearance="Primary"
                            Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.Downloads_Action_Play}"
                            Icon="{ui:SymbolIcon Play24}"
                            Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Padding="8,4"
                            Appearance="Secondary"
                            Command="{Binding DataContext.UninstallHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon Delete24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_Uninstall}"
                            Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Padding="8,4"
                            Command="{Binding DataContext.ShowHistoryInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            ToolTip="{x:Static res:Strings.Common_ShowInFolder}"
                            Visibility="{Binding CanShowInFolder, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Padding="6,4"
                            Command="{Binding DataContext.RemoveHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="{x:Static res:Strings.Downloads_Action_Remove}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title + tools  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="{x:Static res:Strings.Downloads_Title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TotalSpeedLabel}"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <!--  SteamAutoCrack launcher  -->
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding LaunchSteamAutoCrackCommand}"
                Content="{x:Static res:Strings.Downloads_SteamAutoCrack}"
                Icon="{ui:SymbolIcon Wrench24}" />
        </Grid>

        <!--  Overview Metric Cards  -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,16">
            <!-- Active Queue Card -->
            <Border Margin="0,0,8,0" Style="{StaticResource FluentCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Downloads_Stats_Active}" />
                        <TextBlock FontSize="20" FontWeight="Bold" Margin="0,3,0,0" Text="{Binding ActiveCount}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="{StaticResource RadiusMD}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Completed Card -->
            <Border Margin="4,0,4,0" Style="{StaticResource FluentCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Downloads_Stats_Completed}" />
                        <TextBlock FontSize="20" FontWeight="Bold" Margin="0,3,0,0" Text="{Binding CompletedCount}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="{StaticResource RadiusMD}" Background="{StaticResource StatusSuccessBackgroundBrush}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="{StaticResource StatusSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Total Data Card -->
            <Border Margin="8,0,0,0" Style="{StaticResource FluentCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:Strings.Downloads_Stats_TotalData}" />
                        <TextBlock FontSize="20" FontWeight="Bold" Margin="0,3,0,0" Text="{Binding TotalCompletedSize}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="{StaticResource RadiusMD}" Background="{StaticResource StatusInfoBackgroundBrush}">
                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="{StaticResource StatusInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!--  Main Content Area  -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <!--  Empty state hero card  -->
                <Border
                    Margin="0,0,0,16"
                    Padding="36,30"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLG}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            CornerRadius="28"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="26"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Symbol="ArrowDownload24" />
                        </Border>
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{x:Static res:Strings.Downloads_Empty}"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static res:Strings.Downloads_Empty_Desc}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <ui:Button
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Appearance="Primary"
                            Command="{Binding BrowseGamesCommand}"
                            Content="{x:Static res:Strings.Downloads_Action_BrowseGames}"
                            Icon="{ui:SymbolIcon Search24}" />
                    </StackPanel>
                </Border>

                <!--  Queue  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Static res:Strings.Downloads_Section_Active}"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemTemplate="{StaticResource QueueItemTemplate}" ItemsSource="{Binding Queue.Items}" />

                <!--  History  -->
                <Grid Margin="0,14,0,10" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Static res:Strings.Downloads_Section_History}" />
                        <Border
                            Margin="8,0,0,0"
                            Padding="6,1"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource RadiusXS}"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Queue.History.Count}" />
                        </Border>
                    </StackPanel>
                    <ui:Button
                        HorizontalAlignment="Right"
                        Appearance="Secondary"
                        Command="{Binding ClearHistoryCommand}"
                        Content="{x:Static res:Strings.Downloads_Action_ClearHistory}"
                        Icon="{ui:SymbolIcon Delete24}" />
                </Grid>
                <ItemsControl
                    ItemTemplate="{StaticResource HistoryItemTemplate}"
                    ItemsSource="{Binding Queue.History}"
                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
