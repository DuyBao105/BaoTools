<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- =================================================================== -->
    <!--  BAOTOOLS DESIGN SYSTEM TOKENS                                      -->
    <!--  Windows 11 Fluent Design • High Performance • Theme Dynamic        -->
    <!-- =================================================================== -->

    <!-- ── 1. Corner Radius Tokens ──────────────────────────────────────── -->
    <CornerRadius x:Key="RadiusXS">4</CornerRadius>
    <CornerRadius x:Key="RadiusS">6</CornerRadius>
    <CornerRadius x:Key="RadiusSM">6</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusMD">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusLG">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- Top/Bottom specific radii for headers and banners -->
    <CornerRadius x:Key="RadiusTopM">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="RadiusTopL">12,12,0,0</CornerRadius>
    <CornerRadius x:Key="RadiusTopXL">16,16,0,0</CornerRadius>
    <CornerRadius x:Key="RadiusBottomL">0,0,12,12</CornerRadius>

    <!-- ── 2. Spacing & Thickness Tokens ────────────────────────────────── -->
    <Thickness x:Key="PageMargin">24,20,24,20</Thickness>
    <Thickness x:Key="PageMarginCompact">18,16,18,16</Thickness>
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="CardPaddingL">20,18</Thickness>
    <Thickness x:Key="CardPaddingCompact">12,10</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,18</Thickness>
    <Thickness x:Key="ItemSpacing">0,0,0,10</Thickness>

    <!-- ── 3. Typography Fonts ──────────────────────────────────────────── -->
    <FontFamily x:Key="FontFluent">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontCode">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <!-- ── 4. Semantic Status Brushes ───────────────────────────────────── -->
    <!-- Success (Online, Verified, Up to date) -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#1A10B981" />
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#3310B981" />

    <!-- Warning (DRM detected, Pending update, Action needed) -->
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#33F59E0B" />

    <!-- Error (Crash, Missing DLL, Failed connection) -->
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#1AEF4444" />
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#33EF4444" />

    <!-- Info / Telemetry (DirectX, Hardware, Logs) -->
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#1A3B82F6" />
    <SolidColorBrush x:Key="StatusInfoBorderBrush" Color="#333B82F6" />

    <!-- Discord Blurple Accent -->
    <SolidColorBrush x:Key="DiscordBlurpleBrush" Color="#5865F2" />
    <SolidColorBrush x:Key="DiscordBlurpleBackgroundBrush" Color="#1F5865F2" />
    <SolidColorBrush x:Key="DiscordBlurpleBorderBrush" Color="#405865F2" />

    <!-- ── 5. Reusable Card & Control Styles ────────────────────────────── -->
    <!-- Standard Fluent Card -->
    <Style x:Key="FluentCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Interactive Hoverable Card -->
    <Style x:Key="InteractiveFluentCard" TargetType="Border" BasedOn="{StaticResource FluentCard}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Accessible Keyboard Focus Visual Style (Windows 11 Fluent) -->
    <Style x:Key="FluentFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Margin="-3"
                        Stroke="{DynamicResource SystemAccentColorPrimaryBrush}"
                        StrokeThickness="2"
                        SnapsToDevicePixels="True"
                        RadiusX="6"
                        RadiusY="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
